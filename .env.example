# External Prisma-backed AIRA API used by the CEO module.
# When unset, the CEO module falls back to the in-repo seed dataset.

# Base URL of your Prisma API (no trailing slash)
AIRA_API_URL=https://api.example.com

# Bearer token sent as: Authorization: Bearer <token>
AIRA_API_TOKEN=

# Optional: base URL used by the Playwright e2e suite (defaults to http://localhost:8080)
E2E_BASE_URL=
